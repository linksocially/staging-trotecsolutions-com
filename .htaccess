# Trotec Solutions: staging. Keep the noindex header until launch day.
Header always set X-Robots-Tag "noindex, nofollow"

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /en-us/404/index.html
<If "%{REQUEST_URI} =~ m#^/es-us/#">
  ErrorDocument 404 /es-us/404/index.html
</If>

RewriteEngine On
# HTTPS (add the www to bare domain rule when the production host is set)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Home: English is the default language
RewriteRule ^$ /en-us/ [L,R=301]

# Earlier staging addresses at the site root move into /en-us/
RewriteRule ^(about|adixen-turbo-pump-repair|contact|cryopump-repair|ebara-turbo-pump-repair|edwards-turbo-pump-repair|fab-support|leybold-turbo-pump-repair|maglev-turbo-pump-repair|mitsubishi-turbo-pump-repair|osaka-turbo-pump-repair|pfeiffer-turbo-pump-repair|rebuilt-turbo-pumps|request-a-quote|shimadzu-turbo-pump-repair|ship-a-pump-for-repair|site-map|turbo-pump-controller-repair|turbo-pump-exchange|turbo-pump-repair|warranty)(/.*)?$ /en-us/$1/ [L,R=301,NC]
RewriteRule ^(en-us/)?arizona-fab-field-service/?$ /en-us/fab-support/ [L,R=301,NC]

# Old site addresses to their new pages (one 301 each).
# index.html is matched on the browser's request only, so the DirectoryIndex lookup never loops.
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ /en-us/ [L,R=301,NC]
RewriteRule ^About\.html$ /en-us/about/ [L,R=301,NC]
RewriteRule ^Inventory\.html$ /en-us/rebuilt-turbo-pumps/ [L,R=301,NC]
RewriteRule ^Turbo-Pump-Repair\.html$ /en-us/turbo-pump-repair/ [L,R=301,NC]
RewriteRule ^Cryogenic-Pump\.html$ /en-us/cryopump-repair/ [L,R=301,NC]
RewriteRule ^Electronics-And-Controller-Repair\.html$ /en-us/turbo-pump-controller-repair/ [L,R=301,NC]
RewriteRule ^FAB-Support\.html$ /en-us/fab-support/ [L,R=301,NC]
RewriteRule ^RequestQuote\.html$ /en-us/request-a-quote/ [L,R=301,NC]
RewriteRule ^Contact\.html$ /en-us/contact/ [L,R=301,NC]

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://*.clarity.ms https://c.bing.com; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com https://*.clarity.ms https://c.bing.com; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com https://*.clarity.ms https://c.bing.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>
